font-family = JetBrainsMonoNL Nerd Font
font-size = 15
cursor-style = block

# Thicker strokes stop text from looking thin and jagged on a low-DPI
# external monitor, but look too heavy on the MacBook's own screen, so they
# are off here. macOS only. iTerm2 switches this per display; Ghostty has no
# such setting, so run `ghostty-thicken on` at the work desk. It writes
# thicken.conf next to this file to override the value below, and chezmoi
# does not manage that file. The strength applies once thickening is on.
font-thicken = false
font-thicken-strength = 128
config-file = ?thicken.conf

# Cursor trail animation. The path is relative to this config file. Needs
# cursor-style = block above. See shaders/CREDITS.md for provenance.
# cursor_smear_fade.glsl is the older, plain-yellow trail; swap the two lines
# to go back to it.
custom-shader = shaders/cursor_blaze.glsl

# Shift+Enter inserts a newline instead of submitting. Ghostty otherwise
# sends `[27;2;13~`, which Claude Code reads as a plain Enter. Claude
# Code's /terminal-setup handles iTerm2 but not Ghostty.
keybind = shift+enter=text:\n

# Cmd+hjkl resizes tmux panes. tmux binds resize to M-hjkl (dot_tmux.conf),
# and Cmd never reaches tmux on its own, so send ESC+key here instead.
keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl

# Get the pointer out of the way while typing. It comes back on any mouse
# use, and on macOS also when a new window, tab, or split opens.
mouse-hide-while-typing = true

# Close tabs and windows without the "are you sure?" dialog. The default
# `true` skips the dialog only when the shell is at a prompt, which it learns
# from shell integration. tmux does not support that, and Ghostty only sees
# `tmux: client` as the child process, so every tmux tab always asks. Ghostty
# has no per-process exception (ghostty-org/ghostty discussions 2677, 12719),
# so turn the dialog off everywhere.
confirm-close-surface = false

# Put selected text in the system clipboard right away. Inside tmux a
# selection made with Shift+drag can vanish on its own, and this keeps the
# text anyway. The default `true` only fills Ghostty's own selection
# pasteboard, which Cmd+V cannot read on macOS.
copy-on-select = clipboard

# kanagawa-dragon palette, matching the Neovim colorscheme.
# See docs/color-scheme.md for where these values come from and how to
# re-extract them if the Neovim theme changes.

background = #1d1c19
foreground = #c5c9c5

cursor-color = #c5c9c5
cursor-text = #1d1c19

selection-background = #223249
selection-foreground = #c5c9c5

palette = 0=#0d0c0c
palette = 1=#c4746e
palette = 2=#8a9a7b
palette = 3=#c4b28a
palette = 4=#8ba4b0
palette = 5=#a292a3
palette = 6=#8ea4a2
palette = 7=#C8C093
palette = 8=#a6a69c
palette = 9=#E46876
