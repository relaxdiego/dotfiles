font-family = JetBrainsMonoNL Nerd Font
cursor-style = block

# Cursor trail animation. The path is relative to this config file. Needs
# cursor-style = block above. See shaders/CREDITS.md for provenance.
custom-shader = shaders/cursor_smear_fade.glsl

# Shift+Enter inserts a newline instead of submitting. Ghostty otherwise
# sends `[27;2;13~`, which Claude Code reads as a plain Enter. Claude
# Code's /terminal-setup handles iTerm2 but not Ghostty.
keybind = shift+enter=text:\n

# Cmd+hjkl resizes tmux panes. tmux binds resize to M-hjkl (dot_tmux.conf),
# and Cmd never reaches tmux on its own, so send ESC+key here instead.
keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl

# kanagawa-dragon palette, matching the Neovim colorscheme.
# See docs/color-scheme.md for where these values come from and how to
# re-extract them if the Neovim theme changes.

background = #1d1c19
foreground = #c5c9c5

cursor-color = #c5c9c5
cursor-text = #1d1c19

selection-background = #223249
selection-foreground = #c5c9c5

