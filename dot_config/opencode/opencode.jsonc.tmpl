{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-fable-5.1",
  "permission": "allow",
{{- /* pstack ships no opencode plugin, so both paths point at the archive
       .chezmoiexternal.toml unpacks. Absolute is the form measured to work
       for both keys, and .chezmoi.homeDir gives it without writing a real
       home path into this public repo. The instructions file is pstack's own
       session-start mandate, the same bytes Claude Code's SessionStart hook
       emits, which is how opencode gets the routing mandate it has no hook
       to deliver. Those bytes name the skills by their Claude Code ids, which
       do not resolve here, so pstack-skill-names.md translates them. It reads
       as a standalone table, because whether opencode honours the order of
       this array is not something I measured. */}}
  "skills": { "paths": ["{{ .chezmoi.homeDir }}/.local/share/pstack/skills"] },
  "instructions": [
    "{{ .chezmoi.homeDir }}/.local/share/pstack/hooks/session-start-context.md",
    "{{ .chezmoi.homeDir }}/.config/opencode/pstack-skill-names.md"
  ],
  "lsp": {
    "astro": { "disabled": true },
    "bash": { "disabled": true },
    "biome": { "disabled": true },
    "clangd": { "disabled": true },
    "clojure-lsp": { "disabled": true },
    "csharp": { "disabled": true },
    "dart": { "disabled": true },
    "deno": { "disabled": true },
    "dockerfile": { "disabled": true },
    "elixir-ls": { "disabled": true },
    "eslint": { "disabled": true },
    "fsharp": { "disabled": true },
    "gleam": { "disabled": true },
    "haskell-language-server": { "disabled": true },
    "jdtls": { "disabled": true },
    "julials": { "disabled": true },
    "kotlin-ls": { "disabled": true },
    "lua-ls": { "disabled": true },
    "nixd": { "disabled": true },
    "ocaml-lsp": { "disabled": true },
    "oxlint": { "disabled": true },
    "php intelephense": { "disabled": true },
    "prisma": { "disabled": true },
    "razor": { "disabled": true },
    "ruby-lsp": { "disabled": true },
    "rust": { "disabled": true },
    "sourcekit-lsp": { "disabled": true },
    "svelte": { "disabled": true },
    "terraform": { "disabled": true },
    "texlab": { "disabled": true },
    "tinymist": { "disabled": true },
    "ty": { "disabled": true },
    "typescript": { "disabled": true },
