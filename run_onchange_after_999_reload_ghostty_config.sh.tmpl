#!/bin/bash -e

# Remind me to reload Ghostty after its config changes. chezmoi re-runs a
# run_onchange_ script only when the text of the script itself changes, so the
# hash below is what makes this script change whenever the config does.
#
# ghostty config hash: {{ include "dot_config/ghostty/config" | sha256sum }}

# The reminder is not printed here. It goes into a note file that the closing
# banner (run_after_final_home_is_where_the_heart_is.sh) prints inside its box.
{{ if eq .chezmoi.os "darwin" -}}
echo 'Ghostty config changed — reload with Cmd+Shift+,' \
{{- else -}}
echo 'Ghostty config changed — reload with Ctrl+Shift+,' \
{{- end }}
    >> "${TMPDIR:-/tmp}/chezmoi-apply-notes.$(id -u)"
